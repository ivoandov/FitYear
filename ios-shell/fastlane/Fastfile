# FitYear iOS lanes. Run with:  set -a; . ~/.claude/apple-developer.env; set +a; LC_ALL=en_US.UTF-8 fastlane <lane>
default_platform(:ios)

KEY_STORE = File.expand_path("~/liv-backups/apple-developer-id")

def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_filepath: ENV.fetch("APP_STORE_CONNECT_KEY_PATH"),
  )
end

platform :ios do
  desc "Create (or reuse) the Apple Distribution certificate and the App Store provisioning profile"
  lane :certs do
    key = asc_key
    # The cert's PRIVATE KEY is written to the same store as the Apple keys and
    # installed into the login keychain. It is the only copy: losing it means
    # revoking the cert and making a new one, so it goes where the backups are.
    cert(api_key: key, development: false, output_path: KEY_STORE, keychain_path: File.expand_path("~/Library/Keychains/login.keychain-db"))
    # sigh defaults to an App Store profile; passing adhoc/development explicitly trips its guard.
    sigh(api_key: key, app_identifier: "ai.flyhi.fityear", output_path: KEY_STORE, filename: "FitYear_AppStore.mobileprovision")
  end

  desc "Archive a signed App Store build (no upload). Needs no App Store record."
  lane :archive do
    # -allowProvisioningUpdates lets xcodebuild create and refresh the profiles
    # it needs through the API key, which is what makes this work with nobody
    # signed into Xcode. Both targets sign: the app AND the widget extension,
    # which has its own App ID (see widget_certs).
    #
    # Signing is MANUAL and lives in the project (see add-live-activity-target.rb).
    # `-allowProvisioningUpdates` is deliberately NOT used: it makes xcodebuild
    # ask Apple for a DEVELOPMENT profile, which fails on a machine with no
    # registered device ("your team has no devices..."), even though what an
    # archive actually needs is the App Store profile that already exists.
    # Build numbers must be unique per version or the upload is rejected, and
    # the project has no agvtool versioning to bump. Asking App Store Connect
    # what it already has is the one source that cannot drift from reality.
    next_build = latest_testflight_build_number(
      api_key: asc_key,
      app_identifier: "ai.flyhi.fityear",
      initial_build_number: 0,
    ) + 1
    UI.message("Building as build number #{next_build}")

    gym(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "FitYear.ipa",
      clean: false,
      xcargs: "CURRENT_PROJECT_VERSION=#{next_build}",
      export_team_id: "2A48NU3MH4",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "ai.flyhi.fityear" => "ai.flyhi.fityear AppStore",
          "ai.flyhi.fityear.FitYearWidgets" => "ai.flyhi.fityear.FitYearWidgets AppStore",
        },
      },
    )
  end

  desc "Upload the archived build to TestFlight. REQUIRES the App Store Connect app record to exist."
  lane :beta do
    key = asc_key
    pilot(
      api_key: key,
      ipa: "build/FitYear.ipa",
      skip_waiting_for_build_processing: true,
      # Internal testers get it instantly; an EXTERNAL group (Cori) needs the
      # build to clear Beta App Review first, which is a separate submission.
      distribute_external: false,
    )
  end

  desc "Register the widget extension's App ID and its App Store profile"
  lane :widget_certs do
    key = asc_key
    # An embedded app extension ships with its OWN App ID and profile - the
    # app's does not cover it, and an archive fails at signing without this.
    #
    # The App ID itself was registered by a direct App Store Connect API call
    # (POST /v1/bundleIds, ai.flyhi.fityear.FitYearWidgets, id 24NVC2LXTM)
    # rather than by `produce`, which does not accept an api_key at all - it
    # authenticates the Developer Portal through a Spaceship session needing
    # Ivo's password and 2FA. The App ID exists now, so this lane only keeps
    # the PROFILE fresh.
    #
    # It needs no capabilities: a Live Activity is gated by the HOST app's
    # NSSupportsLiveActivities, not by an entitlement on the widget.
    sigh(
      api_key: key,
      app_identifier: "ai.flyhi.fityear.FitYearWidgets",
      output_path: KEY_STORE,
      filename: "FitYearWidgets_AppStore.mobileprovision",
    )
  end
end
