# FitYear iOS lanes. Run with:  set -a; . ~/.claude/apple-developer.env; set +a; LC_ALL=en_US.UTF-8 fastlane <lane>
default_platform(:ios)

KEY_STORE = File.expand_path("~/liv-backups/apple-developer-id")

def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_filepath: ENV.fetch("APP_STORE_CONNECT_KEY_PATH"),
  )
end

platform :ios do
  desc "Create (or reuse) the Apple Distribution certificate and the App Store provisioning profile"
  lane :certs do
    key = asc_key
    # The cert's PRIVATE KEY is written to the same store as the Apple keys and
    # installed into the login keychain. It is the only copy: losing it means
    # revoking the cert and making a new one, so it goes where the backups are.
    cert(api_key: key, development: false, output_path: KEY_STORE, keychain_path: File.expand_path("~/Library/Keychains/login.keychain-db"))
    # sigh defaults to an App Store profile; passing adhoc/development explicitly trips its guard.
    sigh(api_key: key, app_identifier: "ai.flyhi.fityear", output_path: KEY_STORE, filename: "FitYear_AppStore.mobileprovision")
  end

  desc "Register the widget extension's App ID and its App Store profile"
  lane :widget_certs do
    key = asc_key
    # An embedded app extension ships with its OWN App ID and profile - the
    # app's does not cover it, and an archive fails at signing without this.
    #
    # The App ID itself was registered by a direct App Store Connect API call
    # (POST /v1/bundleIds, ai.flyhi.fityear.FitYearWidgets, id 24NVC2LXTM)
    # rather than by `produce`, which does not accept an api_key at all - it
    # authenticates the Developer Portal through a Spaceship session needing
    # Ivo's password and 2FA. The App ID exists now, so this lane only keeps
    # the PROFILE fresh.
    #
    # It needs no capabilities: a Live Activity is gated by the HOST app's
    # NSSupportsLiveActivities, not by an entitlement on the widget.
    sigh(
      api_key: key,
      app_identifier: "ai.flyhi.fityear.FitYearWidgets",
      output_path: KEY_STORE,
      filename: "FitYearWidgets_AppStore.mobileprovision",
    )
  end
end
