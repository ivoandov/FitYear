# FitYear environment variables
#
# Regenerated 2026-07-29 from the actual `process.env.*` reads in src/, scripts/
# and next.config.ts. The previous version named three keys WRONG
# (GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET, GCS_SERVICE_ACCOUNT_JSON)
# and omitted 14 others, so an environment built from it silently lost calendar,
# push and image generation.
#
# NOTE: `vercel env pull` returns every value EMPTY (the team stores them as
# sensitive), so webapp/.env.local is the only local source of real secrets.

# --- Database (Supabase Postgres) -------------------------------------------
# MUST be the transaction pooler (:6543), never the session pooler (:5432).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres

# --- Supabase auth ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Also the HMAC seed for the FitBot build token (lib/api/build-token).
SUPABASE_SECRET_KEY=

# --- AI ---------------------------------------------------------------------
# Program builder: claude-sonnet-5. Single-workout FitBot: claude-opus-4-8.
ANTHROPIC_API_KEY=
# Not used by app code today; kept as a fallback for quick scripts.
GOOGLE_AI_STUDIO_API_KEY=

# --- Google Cloud: exercise images (Imagen 4 on Vertex) + GCS storage --------
GCP_PROJECT_ID=fityear
GCS_BUCKET_NAME=
# Base64 of the service-account JSON; materialized to /tmp on a Vercel cold start.
GCS_SERVICE_ACCOUNT_JSON_BASE64=
VERTEX_AI_LOCATION=us-central1
# Set at runtime by lib/imagen.ts; only override for local ADC.
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Google Calendar OAuth --------------------------------------------------
# PRODUCTION scope only on Vercel, and not recoverable from it - calendar
# connect therefore does not work on previews or locally. The OAuth client lives
# in the OLD GCP project (eighth-contact-283020), not `fityear`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Encrypts the stored refresh/access tokens at rest.
CALENDAR_TOKEN_ENCRYPTION_KEY=

# --- Web Push (closed-app rest alerts) --------------------------------------
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ivo@marketeq.co

# --- Exercise photo admins --------------------------------------------------
# Comma-separated user IDs (not emails) allowed to regenerate the IMAGE of an
# exercise they do not own. Never widened to renames or deletes.
NEXT_PUBLIC_PHOTO_ADMIN_IDS=

# --- Sentry -----------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Production scope only; sourcemap upload is skipped when absent, so preview and
# local builds still pass without it.
SENTRY_AUTH_TOKEN=
